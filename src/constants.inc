.equ M79_pc..sel,0
/* QL: M79_pc.read equ     1<<M79_pc..sclk             read (or idle) microdrive */
.equ M79_pc.read,(1<<M79_pc..sclk)
/* QL: M79_pc.selec equ    M79_pc.read!1<<M79_pc..sel      select bit set */
.equ M79_pc.selec,(M79_pc.read|(1<<M79_pc..sel))
