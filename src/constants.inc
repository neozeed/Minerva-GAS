/* QL:         list */
/* QL:         include 'win1_m_inc_pc' */
/* QL: * PC peripheral chip (zx8302 ic23) registers */
/* QL:         nolist */
/* QL: * The peripheral chip is selected by addresses in the range $18000 to $1bfff. */
/* QL: * The hardware does not decode bits 13-7 and 4-2 of addresses, so the following */
/* QL: * are actually the minimum addresses that perform the given functions. */
/* QL: * On some older ql's, bit 6 is also not decoded, but later m/c's distinguish */
/* QL: * the mc_stat register by decoding it as having bit 6 set. */
/* QL: * It could be unwise to assume that bits 13-7 can be anything but zero. */
/* QL: * It would be novel to redefine the $1800x versions by adding $1c, thus making */
/* QL: * the whole set more conveniently addressable. */
/* QL: * read addresses */
/* QL: M125_pc_clock equ    $18000  real time clock in seconds (long word) */
.equ M125_pc_clock,0x18000
/* QL: M125_pc_ipcrd equ    $18020  IPC read address */
.equ M125_pc_ipcrd,0x18020
/* QL: M125_pc_intr equ     $18021  bits 4..0 set as pending level 2 interrupts */
.equ M125_pc_intr,0x18021
/* QL: M125_pc_trak1 equ    $18022  microdrive read track1 */
.equ M125_pc_trak1,0x18022
/* QL: M125_pc_trak2 equ    $18023  microdrive read track2 */
.equ M125_pc_trak2,0x18023
/* QL: * write addresses */
/* QL: *pc_clc0 equ    $18000  writing anything here resets the clock */
/* QL: *pc_clc1 equ    $18001  clock selected bytes of time */
/* QL: M125_pc_tctrl equ    $18002  transmit control */
.equ M125_pc_tctrl,0x18002
/* QL: M125_pc_ipcwr equ    $18003  IPC write address */
.equ M125_pc_ipcwr,0x18003
/* QL: M125_pc_mctrl equ    $18020  microdrive/link control register */
.equ M125_pc_mctrl,0x18020
/* QL: *M125_pc_intr equ    $18021  7..5 masks and 4..0 to clear interrupt */
/* QL: M125_pc_tdata equ    $18022  transmit register */
.equ M125_pc_tdata,0x18022
/* QL: *mc_stat equ    $18023  on some ql's this controls the video display. */
/* QL: *************** M125_pc_clock function: */
/* QL: * Reading the longword at M125_pc_clock gets the current time. */
/* QL: * Writing anything to M125_pc_clock resets the clock to zero. */
/* QL: * Bytes written to M125_pc_clock+1 increment selected bytes of the current time as */
/* QL: * follows: a zero in bit 4 will increment the msb (to be read back from */
/* QL: * M125_pc_clock) and subsequently a zero in bits 3, 2 and 1 will increment the bytes */
/* QL: * of lesser significance. Bits 7-5 and 0 are not significant. */
/* QL: * Clock setting, etc, could be speeded up by writing combinations of zero bits, */
/* QL: * but there is strange management of carries which make it far too awkward. */
/* QL: * As soon as the sign bit of a byte is set, the next more significant byte can */
/* QL: * no longer be incremented directly, only by propagation of carry. */
/* QL: * On a crash, there is a chance that there may be rubbish written to memory, */
/* QL: * and, what with the lack of decode as well, the clock often gets messed up. */
/* QL: * It gets reset to one of $0w0x0y0z, where w/x/y/z are small, typically 0. */
/* QL: *************** M125_pc_tctrl transmit control register values */
/* QL: * The values set in bits 4..3 of the transmit control register select the */
/* QL: * device to which data written to M125_pc_tdata applies. */
/* QL: * At boot, zero is written here. A zero was also written to M125_pc_tdata, but this */
/* QL: * has been removed. It had the effect of sending a spurious null to the ser1 */
/* QL: * port, which should not have been done. */
/* QL: M125_pc..diro equ    7       direct output (e.g. to network) */
.equ M125_pc..diro,7
/* QL: *   ?    equ    6       0 */
/* QL: *   ?    equ    5       0 */
/* QL: M125_pc..serb equ    4       0=serial io */
.equ M125_pc..serb,4
/* QL: M125_pc..sern equ    3       serial port number */
.equ M125_pc..sern,3
/* QL: *baud2  equ     2       \ */
/* QL: *baud1  equ     1        > three bit baud rate */
/* QL: *baud0  equ     0       / */
/* QL: M125_pc.bmask equ    %00000111       baud rate mask */
.equ M125_pc.bmask,0b00000111
/* QL: M125_pc.notmd equ    %11100111       all bits except mode control */
.equ M125_pc.notmd,0b11100111
/* QL: M125_pc.mdvmd equ    %00010000       microdrive mode */
.equ M125_pc.mdvmd,0b00010000
/* QL: M125_pc.netmd equ    %00011000       network mode */
.equ M125_pc.netmd,0b00011000
/* QL: *************** M125_pc_ipcwr is used to send serial commands and data to IPC. */
/* QL: * The pattern %000011x0 is written here (with x always 1 when serial data is */
/* QL: * supposed to be being fetched), then bit 6 of M125_pc_ipcrd is examined, waiting */
/* QL: * for it to go to zero, indicating that the data bit has been received by the */
/* QL: * IPC and/or that a return bit is ready in bit 7 of pc_ipcrd. */
/* QL: * Nibbles and bytes are sent most significant bit first. */
/* QL: * The sound control function has two 16 bit parameters and, in uncharacteristic */
/* QL: * fashion, these need their least significant byte to be sent first. */
/* QL: * At boot time, %00000001 is written here. at a guess, one of bits 0, 2 or 4 is */
/* QL: * used as a flag "data bit awaiting transmission". */
/* QL: * Note that the PC and the IPC are only connected by two wires, comctl and */
/* QL: * comdata, and the protocol on these is pretty obscure! */
/* QL: *   ?   equ     7       0 */
/* QL: *   ?   equ     6       0 */
/* QL: *   ?   equ     5       0 */
/* QL: *   ?   equ     4       0 */
/* QL: *   ?   equ     3       1 */
/* QL: *   ?   equ     2       1 */
/* QL: *   ?   equ     1       data bit for IPC (comctl/wr  */
/* QL: *   ?   equ     0       0 */
/* QL: *************** M125_pc_ipcrd and M125_pc_mctrl read. */
/* QL: * This returns miscellaneous data bits appertaining to the IPC link, serial */
/* QL: * output control, microdrives and the network. */
/* QL: *   ?   equ     7       data bit from IPC */
/* QL: *   ?   equ     6       set when bit 7 is OK and IPC is ready to receive */
/* QL: M125_pc..cts2 equ    5       CTS on port 2 (set if ser2 transmit held up) */
.equ M125_pc..cts2,5
/* QL: M125_pc..dtr1 equ    4       DTR on port 1 (set if ser1 transmit held up) */
.equ M125_pc..dtr1,4
/* QL: M125_pc..gap  equ    3       gap: set normally, or gap is present on running mdv */
.equ M125_pc..gap,3
/* QL: M125_pc..rxrd equ    2       microdrive read buffer ready */
.equ M125_pc..rxrd,2
/* QL: M125_pc..txfl equ    1       xmit buffer full (mdv or ser) */
.equ M125_pc..txfl,1
/* QL: *   ?    equ    0       network input bit. 1 if active. (netin) */
/* QL: *************** M125_pc_mctrl microdrive control write register */
/* QL: * Selecting a drive is M125_done by clocking a bit along the chain of drives. */
/* QL: * M125_pc..sel is set on the first byte sent and clear on as many more as are */
/* QL: * needed to get to the right drive number. */
/* QL: * Clocking through eight bytes with M125_pc..sel clear selects "mdv9_", or rather, */
/* QL: * as the ql only permits "mdv1_" to "mdv8_", deselects all. */
/* QL: * Anyone who connects more than six external drives will get a shock when the */
/* QL: * seventh one keeps getting selected! */
/* QL: * The clocking is M125_done by M125_pc..sclk transitioning from set to clear, and the */
/* QL: * hardware is expected to be able to manage with one transition each 25us. */
/* QL: * At boot, %0110 was written here, immediately followed by deselecting. */
/* QL: * now just the deselection is done. */
/* QL: *  ?    equ     7 */
/* QL: *  ?    equ     6 */
/* QL: *  ?    equ     5 */
/* QL: *  ?    equ     4 */
/* QL: M125_pc..eras equ    3       microdrive erase */
.equ M125_pc..eras,3
/* QL: M125_pc..writ equ    2       microdrive write */
.equ M125_pc..writ,2
/* QL: M125_pc..sclk equ    1       microdrive select clock bit */
.equ M125_pc..sclk,1
/* QL: M125_pc..sel equ     0       microdrive select bit */
.equ M125_pc..sel,0
/* QL: M125_pc.read equ     1<<M125_pc..sclk             read (or idle) microdrive */
.equ M125_pc.read,(1<<M125_pc..sclk)
/* QL: M125_pc.selec equ    M125_pc.read!1<<M125_pc..sel      select bit set */
.equ M125_pc.selec,(M125_pc.read|(1<<M125_pc..sel))
/* QL: M125_pc.desel equ    M125_pc.read                 select bit not set */
.equ M125_pc.desel,M125_pc.read
/* QL: M125_pc.erase equ    M125_pc.read!1<<M125_pc..eras     erase on / write off */
.equ M125_pc.erase,(M125_pc.read|(1<<M125_pc..eras))
/* QL: M125_pc.write equ    M125_pc.erase!1<<M125_pc..writ    erase and write */
.equ M125_pc.write,(M125_pc.erase|(1<<M125_pc..writ))
/* QL: *************** M125_pc_intr is read to supply the current set of pending */
/* QL: * interrupts, and is written to clear them and/or enable some of them. */
/* QL: * sv_intr holds the current setting and is managed carefully, on a bit basis. */
/* QL: * The three msbs must be set to enable their corresponding interrupts. */
/* QL: * On read, bit 7 is the baud rate clock, pulsing up and down once per bit. */
/* QL: * Bit 6 is normally set, but is clear while an mdv is running. dunno why... */
/* QL: * Bit 5 is the lsb of 1/65536ths of a second, i.e. straight x2 crystal. */
/* QL: * The five lsbs are set on read to indicate which interrupts are pending and */
/* QL: * writing a set bit will clear such an interrupt once it has been serviced. */
/* QL: * At boot, $1f is written here twice, then $c0 is put in sv_intr to start off */
/* QL: * with transmit and IPC interrupts enabled. */
/* QL: * The second write of $1f, one gathers, is because a bug in the h/w sometmes */
/* QL: * causes the first one to fail. */
/* QL: * The IPC interface interrupt deserves a mention. It was useless, and was */
/* QL: * ignored on Minerva until v1.94. Then Hermes finally got it right, and uses it */
/* QL: * to signal serial input buffer data ready (every 8 bytes). */
/* QL: * It actually also happens whenever data transfer goes on between the CPU and */
/* QL: * the IPC, which could be a problem for people who do not use mt.ipcom, but */
/* QL: * all internal routines clear this interrupt before returning. */
/* QL: M125_pc.maskt equ    1<<7    transmit mask register */
.equ M125_pc.maskt,(1<<7)
/* QL: M125_pc.maski equ    1<<6    interface mask register */
.equ M125_pc.maski,(1<<6)
/* QL: M125_pc.maskg equ    1<<5    gap mask register */
.equ M125_pc.maskg,(1<<5)
/* QL: M125_pc.intre equ    1<<4    external interrupt register */
.equ M125_pc.intre,(1<<4)
/* QL: M125_pc.intrf equ    1<<3    frame interrupt register */
.equ M125_pc.intrf,(1<<3)
/* QL: M125_pc.intrt equ    1<<2    transmit interrupt register */
.equ M125_pc.intrt,(1<<2)
/* QL: M125_pc.intri equ    1<<1    interface interrupt register */
.equ M125_pc.intri,(1<<1)
/* QL: M125_pc.intrg equ    1<<0    gap interrupt register */
.equ M125_pc.intrg,(1<<0)
