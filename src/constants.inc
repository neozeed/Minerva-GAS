/* QL: M34_pc..sern equ    3       serial port number */
.equ M34_pc..sern,3
/* QL: *baud2  equ     2       \ */
/* QL: *baud1  equ     1        > three bit baud rate */
/* QL: *baud0  equ     0       / */
/* QL: M34_pc.bmask equ    %00000111       baud rate mask */
.equ M34_pc.bmask,0b00000111
/* QL: M34_pc.notmd equ    %11100111       all bits except mode control */
.equ M34_pc.notmd,0b11100111
/* QL: M34_pc.mdvmd equ    %00010000       microdrive mode */
