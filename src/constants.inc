/* QL: *M1_mc_stat equ    $18023  on some ql's this controls the video display. */
/* QL: *************** M1_pc_clock function: */
/* QL: * Reading the longword at M1_pc_clock gets the current time. */
/* QL: * Writing anything to M1_pc_clock resets the clock to zero. */
/* QL: * Bytes written to M1_pc_clock+1 increment selected bytes of the current time as */
/* QL: * follows: a zero in bit 4 will increment the msb (to be read back from */
/* QL: * M1_pc_clock) and subsequently a zero in bits 3, 2 and 1 will increment the bytes */
/* QL: * of lesser significance. Bits 7-5 and 0 are not significant. */
/* QL: * Clock setting, etc, could be speeded up by writing combinations of zero bits, */
/* QL: * but there is strange management of carries which make it far too awkward. */
/* QL: * As soon as the sign bit of a byte is set, the next more significant byte can */
/* QL: * no longer be incremented directly, only by propagation of carry. */
/* QL: * On a crash, there is a chance that there may be rubbish written to memory, */
/* QL: * and, what with the lack of decode as well, the clock often gets messed up. */
/* QL: * It gets reset to one of $0w0x0y0z, where w/x/y/z are small, typically 0. */
/* QL: *************** M1_pc_tctrl transmit control register values */
/* QL: * The values set in bits 4..3 of the transmit control register select the */
/* QL: * device to which data written to M1_pc_tdata applies. */
/* QL: * At boot, zero is written here. A zero was also written to M1_pc_tdata, but this */
/* QL: * has been removed. It had the effect of sending a spurious null to the ser1 */
/* QL: * port, which should not have been done. */
/* QL: M1_pc..diro equ    7       direct output (e.g. to network) */
.equ M1_pc..diro,7
/* QL: *   ?    equ    6       0 */
/* QL: *   ?    equ    5       0 */
/* QL: M1_pc..serb equ    4       0=serial io */
.equ M1_pc..serb,4
/* QL: M1_pc..sern equ    3       serial port number */
.equ M1_pc..sern,3
/* QL: *baud2  equ     2       \ */
/* QL: *baud1  equ     1        > three bit baud rate */
/* QL: *baud0  equ     0       / */
/* QL: M1_pc.bmask equ    %00000111       baud rate mask */
.equ M1_pc.bmask,0b00000111
/* QL: M1_pc.notmd equ    %11100111       all bits except mode control */
.equ M1_pc.notmd,0b11100111
/* QL: M1_pc.mdvmd equ    %00010000       microdrive mode */
.equ M1_pc.mdvmd,0b00010000
/* QL: M1_pc.netmd equ    %00011000       network mode */
.equ M1_pc.netmd,0b00011000
/* QL: *************** M1_pc_ipcwr is used to send serial commands and data to IPC. */
/* QL: * The pattern %000011x0 is written here (with x always 1 when serial data is */
/* QL: * supposed to be being fetched), then bit 6 of M1_pc_ipcrd is examined, waiting */
/* QL: * for it to go to zero, indicating that the data bit has been received by the */
/* QL: * IPC and/or that a return bit is ready in bit 7 of pc_ipcrd. */
/* QL: * Nibbles and bytes are sent most significant bit first. */
/* QL: * The sound control function has two 16 bit parameters and, in uncharacteristic */
/* QL: * fashion, these need their least significant byte to be sent first. */
/* QL: * At boot time, %00000001 is written here. at a guess, one of bits 0, 2 or 4 is */
/* QL: * used as a flag "data bit awaiting transmission". */
/* QL: * Note that the PC and the IPC are only connected by two wires, comctl and */
/* QL: * comdata, and the protocol on these is pretty obscure! */
/* QL: *   ?   equ     7       0 */
/* QL: *   ?   equ     6       0 */
/* QL: *   ?   equ     5       0 */
/* QL: *   ?   equ     4       0 */
/* QL: *   ?   equ     3       1 */
/* QL: *   ?   equ     2       1 */
/* QL: *   ?   equ     1       data bit for IPC (comctl/wr  */
/* QL: *   ?   equ     0       0 */
/* QL: *************** M1_pc_ipcrd and M1_pc_mctrl read. */
/* QL: * This returns miscellaneous data bits appertaining to the IPC link, serial */
/* QL: * output control, microdrives and the network. */
/* QL: *   ?   equ     7       data bit from IPC */
/* QL: *   ?   equ     6       set when bit 7 is OK and IPC is ready to receive */
/* QL: M1_pc..cts2 equ    5       CTS on port 2 (set if ser2 transmit held up) */
.equ M1_pc..cts2,5
/* QL: M1_pc..dtr1 equ    4       DTR on port 1 (set if ser1 transmit held up) */
.equ M1_pc..dtr1,4
/* QL: M1_pc..gap  equ    3       gap: set normally, or gap is present on running mdv */
.equ M1_pc..gap,3
/* QL: M1_pc..rxrd equ    2       microdrive read buffer ready */
.equ M1_pc..rxrd,2
/* QL: M1_pc..txfl equ    1       xmit buffer full (mdv or ser) */
.equ M1_pc..txfl,1
/* QL: *   ?    equ    0       network input bit. 1 if active. (netin) */
/* QL: *************** M1_pc_mctrl microdrive control write register */
/* QL: * Selecting a drive is done by clocking a bit along the chain of drives. */
/* QL: * M1_pc..sel is set on the first byte sent and clear on as many more as are */
/* QL: * needed to get to the right drive number. */
/* QL: * Clocking through eight bytes with M1_pc..sel clear selects "mdv9_", or rather, */
/* QL: * as the ql only permits "mdv1_" to "mdv8_", deselects all. */
/* QL: * Anyone who connects more than six external drives will get a shock when the */
/* QL: * seventh one keeps getting selected! */
/* QL: * The clocking is done by M1_pc..sclk transitioning from set to clear, and the */
/* QL: * hardware is expected to be able to manage with one transition each 25us. */
/* QL: * At boot, %0110 was written here, immediately followed by deselecting. */
/* QL: * now just the deselection is done. */
/* QL: *  ?    equ     7 */
/* QL: *  ?    equ     6 */
/* QL: *  ?    equ     5 */
/* QL: *  ?    equ     4 */
/* QL: M1_pc..eras equ    3       microdrive erase */
.equ M1_pc..eras,3
/* QL: M1_pc..writ equ    2       microdrive write */
.equ M1_pc..writ,2
/* QL: M1_pc..sclk equ    1       microdrive select clock bit */
.equ M1_pc..sclk,1
/* QL: M1_pc..sel equ     0       microdrive select bit */
.equ M1_pc..sel,0
/* QL: M1_pc.read equ     1<<M1_pc..sclk             read (or idle) microdrive */
.equ M1_pc.read,(1<<M1_pc..sclk)
/* QL: M1_pc.selec equ    M1_pc.read!1<<M1_pc..sel      select bit set */
.equ M1_pc.selec,(M1_pc.read|(1<<M1_pc..sel))
/* QL: M1_pc.desel equ    M1_pc.read                 select bit not set */
.equ M1_pc.desel,M1_pc.read
/* QL: M1_pc.erase equ    M1_pc.read!1<<M1_pc..eras     erase on / write off */
