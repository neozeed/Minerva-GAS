/* QL: *   ?    equ    5       0 */
/* QL: M77_pc..serb equ    4       0=serial io */
.equ M77_pc..serb,4
/* QL: M77_pc..sern equ    3       serial port number */
.equ M77_pc..sern,3
/* QL: *baud2  equ     2       \ */
/* QL: *baud1  equ     1        > three bit baud rate */
/* QL: *baud0  equ     0       / */
/* QL: M77_pc.bmask equ    %00000111       baud rate mask */
.equ M77_pc.bmask,0b00000111
/* QL: M77_pc.notmd equ    %11100111       all bits except mode control */
