/* QL: * memory block table definitions */
/* QL:         nolist */
/* QL: * memory block table entries */
/* QL:         offset  0 */
/* QL: M5_bt_stat ds.b    1       drive id / status byte - see below */
.equ M5_bt_stat,0
/* QL: M5_bt_prior ds.b   1       block priority */
.equ M5_bt_prior,1
/* QL: M5_bt_sectr ds.w   1       sector number (microdrive*2) */
.equ M5_bt_sectr,2
/* QL: M5_bt_filnr ds.w   1       file number (microdrive)   } logical */
.equ M5_bt_filnr,4
/* QL: M5_bt_block ds.w   1       block number (microdrive)  } location */
.equ M5_bt_block,6
/* QL: M5_bt_end */
.equ M5_bt_end,8
/* QL: * bits of status codes */
/* QL: M5_bt..file equ    0       set if a file block */
.equ M5_bt..file,0
/* QL: M5_bt..accs equ    1       set if contents may be accessed */
.equ M5_bt..accs,1
/* QL: M5_bt..wreq equ    2       set if block required to be written */
.equ M5_bt..wreq,2
/* QL: M5_bt..rdvr equ    3       set if block required to be read / verified */
.equ M5_bt..rdvr,3
/* QL: * The most significant 4 bits of the status byte contain the pointer to the */
/* QL: * physical device block M5_sv_fsdef, the least significant are the status codes: */
/* QL: M5_bt.unav equ     0                       unavailable to file system */
.equ M5_bt.unav,0
/* QL: M5_bt.empty equ    1<<M5_bt..file             empty */
.equ M5_bt.empty,(1<<M5_bt..file)
/* QL: M5_bt.rreq equ     M5_bt.empty!1<<M5_bt..rdvr    required to be read */
.equ M5_bt.rreq,(M5_bt.empty|(1<<M5_bt..rdvr))
/* QL: M5_bt.true equ     M5_bt.empty!1<<M5_bt..accs    true representation of file */
.equ M5_bt.true,(M5_bt.empty|(1<<M5_bt..accs))
/* QL: M5_bt.aver equ     M5_bt.true!1<<M5_bt..rdvr     awaiting verify */
.equ M5_bt.aver,(M5_bt.true|(1<<M5_bt..rdvr))
/* QL: M5_bt.updt equ     M5_bt.true!1<<M5_bt..wreq     updated */
.equ M5_bt.updt,(M5_bt.true|(1<<M5_bt..wreq))
/* QL: * status code masks */
/* QL: M5_bt.actn equ     1<<M5_bt..rdvr!1<<M5_bt..wreq check for read or write request */
.equ M5_bt.actn,((1<<M5_bt..rdvr)|(1<<M5_bt..wreq))
/* QL: M5_bt.inuse equ    M5_bt.actn!1<<M5_bt..accs     check if a file block in use */
.equ M5_bt.inuse,(M5_bt.actn|(1<<M5_bt..accs))
